<display version="2.0.0">
  <name>Display</name>
  <widget type="group" version="3.0.0">
    <name>dcam1_Group</name>
    <x>250</x>
    <y>120</y>
    <width>100</width>
    <height>80</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="symbol" version="2.0.0">
      <name>dcam1</name>
      <symbols>
        <symbol>techui-support/symbols/camera.svg</symbol>
