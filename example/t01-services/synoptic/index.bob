          <target>replace</target>
        </action>
      </actions>
      <tooltip>$(pv_name)
$(pv_value)
$(actions)</tooltip>
      <pv_name>BL01T-DI-CAM-01:STA</pv_name>
      <run_actions_on_mouse_click>true</run_actions_on_mouse_click>
    </widget>
    <widget type="label" version="2.0.0">
